# ==========================================
# LifeQuest 3.0 - Environment Configuration
# ==========================================

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database (PostgreSQL / SQLite)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Authentication & Security
SECRET_KEY=your-secure-random-secret-key-at-least-32-chars
ADMIN_DEFAULT_PASSWORD=YourAdminSecurePassword123!

# Cache & Rate Limiting (Redis - Optional, fallback to in-memory)
REDIS_URL=redis://default:password@host:port

# Sentry Error Tracking (Optional - Leave blank to disable)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# AI Virtual Coach (Google Gemini - Optional)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
